---
// One titled block inside <Planning>, with its source links underneath:
// <PlanItem title="이벤트 스토밍" links={[{ label: "FigJam", href: "..." }]}> ...markdown... </PlanItem>
type Link = {
  label: string
  href: string
}

type Props = {
  title: string
  links?: Link[]
}

const { title, links = [] } = Astro.props
---

<section class="plan-item border-t border-black/10 dark:border-white/15 pt-6 mt-8 first:mt-0 first:border-t-0 first:pt-0">
  <p class="not-prose flex items-center gap-2 text-lg font-semibold text-black dark:text-white">
    <span class="inline-block size-1.5 rounded-full bg-black/40 dark:bg-white/50" aria-hidden="true"></span>
    {title}
  </p>
  <div class="plan-item-body">
    <slot />
  </div>
  {links.length > 0 && (
    <p class="not-prose mt-3 flex flex-wrap gap-2 text-sm">
      {links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="rounded-full border border-black/15 dark:border-white/25 px-3 py-1 text-black/70 dark:text-white/70 hover:bg-black/5 hover:dark:bg-white/10 blend">
          {link.label} ↗
        </a>
      ))}
    </p>
  )}
</section>
