---
import TroubleshootingBox from "@components/TroubleshootingBox.astro"

// Used inside project .mdx files as <Troubleshooting items={frontmatter.troubleshooting} repo={frontmatter.repoUrl} />
type Props = {
  repo?: string
  items?: {
    title: string
    problem: string
    cause: string
    solution: string
    result: string
    post?: string
  }[]
}

const { items = [], repo } = Astro.props
---

{items.map((item) => <TroubleshootingBox {...item} repo={repo} />)}
