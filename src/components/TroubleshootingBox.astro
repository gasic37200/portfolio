---
type Props = {
  title?: string
  problem: string
  cause: string
  solution: string
  result: string
  post?: string
  repo?: string
}

const { title, problem, cause, solution, result, post, repo } = Astro.props

// Split `code` spans into inline code and "#123" references into links to the repo's issue
// (GitHub redirects PR numbers to /pull/)
function parts(text: string): { text: string; href?: string; code?: boolean }[] {
  return text.split(/(`[^`]+`|#\d+)/).filter(Boolean).map((piece) => {
    if (/^`[^`]+`$/.test(piece)) return { text: piece.slice(1, -1), code: true }
    if (repo && /^#\d+$/.test(piece)) return { text: piece, href: `${repo}/issues/${piece.slice(1)}` }
    return { text: piece }
  })
}

const steps = [
  { label: "현상", text: problem, dot: "bg-rose-500", tone: "text-rose-600 dark:text-rose-400" },
  { label: "원인 분석 및 근거", text: cause, dot: "bg-amber-500", tone: "text-amber-600 dark:text-amber-400" },
  { label: "해결 방안", text: solution, dot: "bg-sky-500", tone: "text-sky-600 dark:text-sky-400" },
  { label: "결과 및 검증", text: result, dot: "bg-emerald-500", tone: "text-emerald-600 dark:text-emerald-400" },
]
---

<div class="not-prose my-6 rounded-xl border border-black/15 dark:border-white/20 overflow-hidden">
  {(title || post) && (
    <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 px-5 py-3 bg-black/[0.03] dark:bg-white/5 border-b border-black/10 dark:border-white/15">
      {title && <p class="font-semibold text-black dark:text-white">{title}</p>}
      {post && (
        <a href={`/blog/${post}`} class="group flex items-center gap-1 text-sm shrink-0 text-black/60 dark:text-white/60 hover:text-black hover:dark:text-white blend">
          자세히 보기
          <span class="translate-x-0 group-hover:translate-x-0.5 blend">→</span>
        </a>
      )}
    </div>
  )}
  <ol class="px-5 py-4">
    {steps.map((step) => (
      <li class="grid grid-cols-[auto_1fr] gap-x-3 pb-4 last:pb-0 group/step">
        <div class="flex flex-col items-center pt-1.5">
          <span class={`size-2.5 rounded-full shrink-0 ${step.dot}`} />
          <span class="w-px flex-1 mt-1.5 bg-black/10 dark:bg-white/15 group-last/step:hidden" />
        </div>
        <div>
          <p class={`text-xs font-semibold tracking-wide ${step.tone}`}>{step.label}</p>
          <p class="mt-0.5 text-sm leading-relaxed text-black/80 dark:text-white/80">
            {parts(step.text).map((part) => part.href
              ? <a href={part.href} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-black hover:dark:text-white">{part.text}</a>
              : part.code
                ? <code class="rounded px-1 py-0.5 text-[0.85em] bg-black/[0.06] dark:bg-white/10">{part.text}</code>
                : part.text)}
          </p>
        </div>
      </li>
    ))}
  </ol>
</div>
