---
// Summary box at the top of a decision-record tech note (frontmatter `decision`)
type Props = {
  question: string
  choice: string
  reasons: string[]
  tradeoff: string
}

const { question, choice, reasons, tradeoff } = Astro.props
---

<div class="not-prose my-6 rounded-xl border border-black/15 dark:border-white/20 overflow-hidden">
  <div class="px-5 py-3 bg-black/[0.03] dark:bg-white/5 border-b border-black/10 dark:border-white/15">
    <p class="text-xs font-semibold tracking-wide text-black/50 dark:text-white/50">결정해야 했던 것</p>
    <p class="mt-0.5 font-semibold text-black dark:text-white">{question}</p>
  </div>
  <dl class="px-5 py-4 space-y-4 text-sm leading-relaxed">
    <div>
      <dt class="text-xs font-semibold tracking-wide text-sky-600 dark:text-sky-400">고른 방법</dt>
      <dd class="mt-0.5 text-black/80 dark:text-white/80">{choice}</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold tracking-wide text-emerald-600 dark:text-emerald-400">고른 이유</dt>
      <dd class="mt-0.5">
        <ul class="list-disc pl-5 space-y-1 text-black/80 dark:text-white/80">
          {reasons.map((reason) => <li>{reason}</li>)}
        </ul>
      </dd>
    </div>
    <div>
      <dt class="text-xs font-semibold tracking-wide text-amber-600 dark:text-amber-400">감수한 것</dt>
      <dd class="mt-0.5 text-black/80 dark:text-white/80">{tradeoff}</dd>
    </div>
  </dl>
</div>
